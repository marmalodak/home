# MOTD
function echo_color() {
  local color="$1"
  printf "${color}$2\033[0m\n"
}

echo
echo_color "\033[0;90m" "            ⤹ programming language"
echo_color "\033[0;90m" "curl cht.sh/go/execute+external_program"
echo_color "\033[0;90m" "                      ↳ question"

echo
echo_color "\033[0;90m" "curl v2.wttr.in/94041 for weather in Mountain View"

echo
echo_color "\033[0;90m" "curl cht.sh/:help"

echo
echo_color "\033[0;90m" "remember run-help"

echo
echo_color "\033[0;90m" "C-<space> ' to select a window index"
echo_color "\033[0;90m" "C-<space> w to select a window interactively"

