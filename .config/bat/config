# Each line either contains a comment or a command-line option that you want to pass to `bat` by default

# `bat --list-themes`, default is "Monokai Extended Light"
# --theme="GitHub"

# Enable this to use italic text on the terminal. This is not supported on all
# terminal emulators (like tmux, by default):
--italic-text=always

# Uncomment the following line to disable automatic paging:
#--paging=never

--pager="less --RAW-CONTROL-CHARS --quit-if-one-screen --use-color"
# --pager=builtin # does not work with `gerrit-change-show`

--color=always
--number
--decorations=auto
--paging=auto


# Syntax mappings: map a certain filename pattern to a language.
#   Example 1: use the C++ syntax for Arduino .ino files
#   Example 2: Use ".gitignore"-style highlighting for ".ignore" files
#--map-syntax "*.ino:C++"
#--map-syntax ".ignore:Git Ignore"
--map-syntax "*settings:Bourne Again Shell (bash)"
--map-syntax "*:Bourne Again Shell (bash)"
